# Base Home Assistant URL for REST API access.
export HA_URL="http://homeassistant:8123"

# Home Assistant long-lived access token used by the renderer.
export HA_TOKEN=""

# Comma-separated entity IDs to fetch from HA (include inside/outside/weather).
export ENTITIES=""

# Entity IDs used in the template.
export INSIDE_ENTITY=""
export OUTSIDE_ENTITY="sensor.zse70_front_garage_air_temperature"
export WEATHER_ENTITY="weather.forecast_home"
export FORECAST_MODE="websocket"
export FORECAST_TYPE="daily"

# Dimensions for the rendered PNG.
export WIDTH="800"
export HEIGHT="480"

# Seconds between refreshes.
export REFRESH_SECONDS="60"
export DISPLAY_REFRESH_RATE="60"

# Public URL used in /api/setup and /api/display responses.
export PUBLIC_URL="http://192.168.40.16:9080"

# File locations inside the container.
export OUTPUT_PATH="/data/trmnl.bmp"
export LOG_PATH="/data/log.txt"
export DEVICE_STATE_PATH="/data/device_state.json"
export TEMPLATE_PATH="/app/templates/trmnl.svg.j2"
export DEVICE_CONFIG_PATH="/data/devices.json"
export OUTPUT_FORMAT="bmp"
export MAX_CACHE_PER_DEVICE="3"
export EARLY_DISPLAY_THRESHOLD="5"
export LATE_DISPLAY_THRESHOLD=""

# MQTT settings for HA discovery.
export MQTT_ENABLE="true"
export MQTT_HOST="mosquitto"
export MQTT_PORT="1883"
export MQTT_USERNAME=""
export MQTT_PASSWORD=""
export MQTT_PREFIX="trmnl"
export MQTT_DISCOVERY_PREFIX="homeassistant"

# HTTP server config.
export HOST="0.0.0.0"
export PORT="9080"
