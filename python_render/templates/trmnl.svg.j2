<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}">
  <style>
    text { font-family: "DejaVu Sans", Arial, sans-serif; fill: #000; }
    .title { font-size: 34px; font-weight: 700; }
    .timestamp { font-size: 16px; fill: #333; }
    .label { font-size: 16px; fill: #333; }
    .value { font-size: 44px; font-weight: 700; }
    .unit { font-size: 20px; }
    .section-title { font-size: 20px; font-weight: 700; }
    .row { font-size: 18px; }
    .error { font-size: 14px; fill: #555; }
    .muted { fill: #666; }
    .divider { stroke: #ddd; stroke-width: 2; }
  </style>
  <rect x="0" y="0" width="{{ width }}" height="{{ height }}" fill="#fff" />

  <text x="24" y="42" class="title">Weather Station</text>
  <text x="24" y="66" class="timestamp">{{ now }}</text>

  <!-- Battery icon -->
  <rect x="{{ width - 140 }}" y="24" width="90" height="28" rx="4" ry="4" fill="none" stroke="#111" stroke-width="2" />
  <rect x="{{ width - 46 }}" y="32" width="8" height="12" rx="2" ry="2" fill="#111" />
  {% set level = device.battery_level %}
  {% if level %}
    {% set bars = 0 %}
    {% if level == "full" %}
      {% set bars = 4 %}
    {% elif level == "high" %}
      {% set bars = 3 %}
    {% elif level == "low" %}
      {% set bars = 2 %}
    {% else %}
      {% set bars = 1 %}
    {% endif %}
    {% for i in range(bars) %}
      <rect x="{{ width - 136 + (i * 20) }}" y="28" width="16" height="20" fill="#111" />
    {% endfor %}
  {% endif %}
  <text x="{{ width - 170 }}" y="44" class="label">
    {% if device.battery_percent is not none %}{{ device.battery_percent }}%{% else %}--%{% endif %}
  </text>

  <line x1="24" y1="86" x2="{{ width - 24 }}" y2="86" class="divider" />

  <text x="24" y="118" class="label">Inside</text>
  <text x="24" y="170" class="value">
    {{ inside.state if inside else "--" }}
    <tspan class="unit">{{ inside.unit if inside else "" }}</tspan>
  </text>
  <text x="24" y="198" class="label muted">{{ inside.name if inside else "INSIDE_ENTITY not set" }}</text>

  <text x="{{ (width / 2) + 10 }}" y="118" class="label">Outside</text>
  <text x="{{ (width / 2) + 10 }}" y="170" class="value">
    {{ outside.state if outside else "--" }}
    <tspan class="unit">{{ outside.unit if outside else "" }}</tspan>
  </text>
  <text x="{{ (width / 2) + 10 }}" y="198" class="label muted">{{ outside.name if outside else "OUTSIDE_ENTITY not set" }}</text>

  <line x1="24" y1="220" x2="{{ width - 24 }}" y2="220" class="divider" />

  <text x="24" y="250" class="section-title">Forecast</text>
  <text x="{{ (width / 2) + 10 }}" y="250" class="section-title">Conditions</text>
  <text x="{{ width - 220 }}" y="250" class="label muted">
    RSSI: {% if device.rssi is not none %}{{ device.rssi }}{% else %}--{% endif %}
  </text>

  {% for item in forecast %}
    <text x="24" y="{{ 280 + (loop.index0 * 26) }}" class="row">
      {{ item.datetime | default("") }}
    </text>
    <text x="160" y="{{ 280 + (loop.index0 * 26) }}" class="row">
      {{ item.temperature }}{{ temp_unit or "°" }}
      {% if item.templow is defined %}/{{ item.templow }}{{ temp_unit or "°" }}{% endif %}
    </text>
    <text x="{{ (width / 2) + 10 }}" y="{{ 280 + (loop.index0 * 26) }}" class="row">
      {{ item.condition }}
    </text>
  {% else %}
    <text x="24" y="280" class="row muted">No forecast data (WEATHER_ENTITY missing?)</text>
  {% endfor %}

  {% if last_error %}
    <text x="24" y="{{ height - 20 }}" class="error">Last error: {{ last_error }}</text>
  {% endif %}
</svg>
