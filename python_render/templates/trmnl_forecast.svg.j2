<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}">
  <style>
    @font-face {
      font-family: "TGL_0-1451Eng";
      src: url("../fonts/TGL_0-1451Eng.ttf");
    }
    text { font-family: "DejaVu Sans", "Noto Emoji", "Noto Color Emoji", Arial, sans-serif; fill: #000; font-weight: 700; }
    .title { font-size: 72px; font-weight: 700; }
    .label { font-size: 22px; fill: #000; }
    .value { font-size: 40px; font-weight: 700; }
    .muted { fill: #000; }
    .dim { fill: #000; font-weight: 700; }
    .mid { fill: #000; font-weight: 700; }
    .bar { font-weight: 400; }
    .divider { stroke: #000; stroke-width: 2; }
    .icon { font-size: 37px; font-family: "DejaVu Sans", Arial, sans-serif; font-weight: 700; }
    .icon-light { font-weight: 400; }
    .icon-big { font-size: 207px; font-family: "DejaVu Sans", Arial, sans-serif; font-weight: 700; }
    .small { font-size: 19px; }
    .tiny { font-size: 17px; }
    .tiny-top { font-size: 20px; }
    .temp-big { font-size: 114px; }
    .temp-big-small { font-size: 44px; }
    .temp-stack { font-size: 78px; font-weight: 700; }
    .temp-stack-deg { font-size: 80%; }
    .day { font-size: 22px; font-weight: 700; }
    .temp-main { font-size: 24px; }
    .temp { font-family: "TGL_0-1451Eng", "DejaVu Sans", Arial, sans-serif; }
    .tall { transform: scale(1, 1.3); transform-origin: center; }
  </style>
  {% macro cloud_icon(x, y, size, shade="#000", variant="cloudy") -%}
    {% set s = size / 60 %}
    <g transform="translate({{ x }} {{ y }}) scale({{ s }})" fill="{{ shade }}">
      <circle cx="-18" cy="8" r="9" />
      {% if variant == "cloudy" %}
        <circle cx="0" cy="10" r="10" />
      {% endif %}
      <circle cx="18" cy="8" r="9" />
      <circle cx="-12" cy="0" r="12" />
      <circle cx="6" cy="-10" r="16" />
      {% if variant == "cloudy" %}
        <circle cx="22" cy="0" r="12" />
      {% endif %}
    </g>
  {%- endmacro %}
  <rect x="0" y="0" width="{{ width }}" height="{{ height }}" fill="#fff" />

  <!-- Current row -->
  {% set condition = (current_weather.condition or "--").replace("_", "-") %}
  {% if condition == "partlycloudy" %}
    {% set condition = "partly-cloudy" %}
  {% endif %}
  {% set parts = condition.split("-") %}
  <text x="20" y="56" class="title">{{ parts[0] }}</text>
  {% if parts|length > 1 %}
    <text x="20" y="136" class="title">{{ parts[1] }}</text>
  {% endif %}
  {% if current_weather.icon %}
    {% if (current_weather.condition or '') in ('cloudy','overcast','partlycloudy','partly-cloudy') %}
      {{ cloud_icon(395 + (current_weather.icon_dx_big or 0), 111 + (current_weather.icon_dy_big or 0), 207 * (current_weather.icon_scale_big or 1), "#777", "cloudy" if (current_weather.condition or '') in ('cloudy','overcast') else "partly") }}
    {% else %}
      <text x="{{ 295 + (current_weather.icon_dx_big or 0) }}" y="{{ 131 + (current_weather.icon_dy_big or 0) }}" class="icon-big" style="font-size: {{ 207 * 0.85 * (current_weather.icon_scale_big or 1) }}px;">{{ current_weather.icon }}</text>
    {% endif %}
  {% endif %}
  {% set top_temp = outside.temp_pair if outside and outside.temp_pair else current_weather.temp_pair %}
  <text x="{{ width - 195 }}" y="155" class="value temp tall temp-big" text-anchor="end">
    {% if top_temp.c_value is defined %}
      {{ top_temp.c_value }}
    {% else %}
      {{ top_temp.c }}
    {% endif %}
  </text>
  <circle cx="{{ width - 177 }}" cy="32" r="6" fill="none" stroke="#000" stroke-width="2" />
  <text x="{{ width - 185 }}" y="120" class="temp-stack" text-anchor="start">
    |{{ top_temp.f }}
  </text>
  {# humidity/pressure/wind moved to bottom row #}
  {# duplicate temp block removed #}

  {% if alert_summary %}
    {% if alert_summary|length > 1 %}
      <text x="20" y="180" class="small" style="font-size: 29px;">{{ alert_summary[0] }}</text>
      <text x="20" y="200" class="small" style="font-size: 29px;">{{ alert_summary[1] }}</text>
    {% else %}
      <text x="20" y="200" class="small" style="font-size: 29px;">{{ alert_summary[0] }}</text>
    {% endif %}
  {% endif %}

  <line x1="20" y1="208" x2="{{ width - 20 }}" y2="208" class="divider" />

  <!-- Hourly row -->
  {% set hourly_items = forecast_hourly[2:] %}
  {% set hourly_count = hourly_items | length %}
  {% if hourly_count == 0 %}
    <text x="20" y="164" class="label muted">No hourly forecast</text>
  {% else %}
    {% set slot = (width - 40) / hourly_count %}
    {% for item in hourly_items %}
      {% set x = 20 + (loop.index0 * slot) + (slot / 2) %}
      <text x="{{ x - 24 }}" y="248" text-anchor="middle" class="small" style="font-size: 23px;">{{ item.label or "" }}</text>
      {% if (item.condition or '') in ('cloudy','overcast','partlycloudy','partly-cloudy') %}
        {{ cloud_icon(x + 26 + (item.icon_dx or 0), 248 + (item.icon_dy or 0), 37 * (item.icon_scale or 1), "#777", "cloudy" if (item.condition or '') in ('cloudy','overcast') else "partly") }}
      {% else %}
        <text x="{{ x + 26 + (item.icon_dx or 0) }}" y="{{ 248 + (item.icon_dy or 0) }}" text-anchor="middle" class="icon" style="font-size: {{ 37 * (item.icon_scale or 1) }}px;">{{ item.icon or "•" }}</text>
      {% endif %}
      <text x="{{ x + 2 }}" y="285" text-anchor="end" class="label mid temp tall temp-main" style="font-size: 31px;">
        {{ item.temperature.c }}
      </text>
      <text x="{{ x + 4 }}" y="285" text-anchor="start" class="tiny temp tall" style="font-size: 22px;">
        <tspan class="bar">|</tspan><tspan dx="2">{{ item.temperature.f }}</tspan>
      </text>
    {% endfor %}
  {% endif %}

  <line x1="20" y1="315" x2="{{ width - 20 }}" y2="315" class="divider" />

  <!-- Daily row -->
  {% set daily_count = forecast_daily | length %}
  {% if daily_count == 0 %}
    <text x="20" y="284" class="label muted">No daily forecast</text>
  {% else %}
    {% set slot = (width - 40) / daily_count %}
    {% for item in forecast_daily %}
      {% set x = 20 + (loop.index0 * slot) + (slot / 2) %}
      <text x="{{ x - 24 }}" y="353" text-anchor="middle" class="day">{{ item.label or "" }}</text>
      {% if (item.condition or '') in ('cloudy','overcast','partlycloudy','partly-cloudy') %}
        {{ cloud_icon(x + 26 + (item.icon_dx or 0), 353 + (item.icon_dy or 0), 37 * (item.icon_scale or 1), "#777", "cloudy" if (item.condition or '') in ('cloudy','overcast') else "partly") }}
      {% else %}
        <text x="{{ x + 26 + (item.icon_dx or 0) }}" y="{{ 353 + (item.icon_dy or 0) }}" text-anchor="middle" class="icon" style="font-size: {{ 37 * (item.icon_scale or 1) }}px;">{{ item.icon or "•" }}</text>
      {% endif %}
      <text x="{{ x + 2 }}" y="363" text-anchor="end" class="label mid temp tall temp-main" style="font-size: 31px;">
        {{ item.temperature.c }}
      </text>
      <text x="{{ x + 4 }}" y="363" text-anchor="start" class="tiny temp tall" style="font-size: 22px;">
        <tspan class="bar">|</tspan><tspan dx="2">{{ item.temperature.f }}</tspan>
      </text>
      <text x="{{ x + 2 }}" y="389" text-anchor="end" class="small dim temp tall" style="font-size: 24px;">
        {{ item.templow.c }}
      </text>
      <text x="{{ x + 4 }}" y="389" text-anchor="start" class="tiny temp tall" style="font-size: 21px;">
        <tspan class="bar">|</tspan><tspan dx="2">{{ item.templow.f }}</tspan>
      </text>
    {% endfor %}
  {% endif %}

  <line x1="20" y1="{{ height - 40 }}" x2="{{ width - 20 }}" y2="{{ height - 40 }}" class="divider" />

  <text x="5" y="{{ height - 3 }}" class="temp" style="font-size: 21px; font-weight: 700; fill: #555;" transform="scale(1,1.2)" transform-origin="left {{ height - 3 }}px">
    {{ now }}
  </text>
  <path d="M{{ 205 }} {{ height - 10 }} Q{{ 210 }} {{ height - 20 }} {{ 215 }} {{ height - 10 }} Q{{ 215 }} {{ height - 4 }} {{ 210 }} {{ height - 2 }} Q{{ 205 }} {{ height - 4 }} {{ 205 }} {{ height - 10 }} Z" fill="#000" />
  <text x="220" y="{{ height - 3 }}" class="small muted">
    {% if current_weather.humidity is not none %}{{ current_weather.humidity }}%{% else %}--{% endif %}
  </text>
  <text x="{{ width - 480 }}" y="{{ height - 2 }}" class="small muted">
    {% if current_weather.pressure is not none %}{{ current_weather.pressure }}mb{% else %}--{% endif %}
  </text>
  <text x="{{ width - 330 }}" y="{{ height - 2 }}" class="small muted">
    {% if current_weather.wind_speed is not none %}{{ current_weather.wind_speed }}kmh{% else %}--{% endif %}
  </text>
  {% if device.get("rssi") is not none or device.get("battery_percent") is not none or device.get("battery_level") or device.get("battery_voltage") is not none %}
  <!-- Battery icon -->
  <rect x="{{ width - 55 }}" y="{{ height - 16 }}" width="48" height="14" rx="3" ry="3" fill="none" stroke="#333" stroke-width="2" />
  <rect x="{{ width - 5 }}" y="{{ height - 13 }}" width="5" height="8" rx="2" ry="2" fill="#333" />
  {% set level = device.get("battery_level") %}
  {% if level %}
    {% set bars = 0 %}
    {% if level == "full" %}
      {% set bars = 4 %}
    {% elif level == "high" %}
      {% set bars = 3 %}
    {% elif level == "low" %}
      {% set bars = 2 %}
    {% else %}
      {% set bars = 1 %}
    {% endif %}
    {% for i in range(bars) %}
      <rect x="{{ width - 51 + (i * 10) }}" y="{{ height - 14 }}" width="8" height="10" fill="#333" />
    {% endfor %}
  {% endif %}

  {% set rssi = device.get("rssi") %}
  {% set wifi_bars = 0 %}
  {% if rssi is not none %}
    {% if rssi >= -50 %}
      {% set wifi_bars = 4 %}
    {% elif rssi >= -60 %}
      {% set wifi_bars = 3 %}
    {% elif rssi >= -70 %}
      {% set wifi_bars = 2 %}
    {% elif rssi >= -80 %}
      {% set wifi_bars = 1 %}
    {% else %}
      {% set wifi_bars = 0 %}
    {% endif %}
  {% endif %}
  {% set wifi_x = width - 159 %}
  {% set wifi_y = height - 15 %}
  {% if rssi is not none %}
    <text x="{{ wifi_x - 38 }}" y="{{ height - 2 }}" class="small muted">{{ "%.0f" % rssi }}</text>
  {% endif %}
  {% if rssi is not none %}
    {% for i in range(4) %}
      {% set bar_h = 4 + (i * 3) %}
      {% set bar_y = wifi_y + (12 - bar_h) %}
      {% if i < wifi_bars %}
        <rect x="{{ wifi_x + (i * 8) }}" y="{{ bar_y }}" width="6" height="{{ bar_h }}" fill="#333" />
      {% else %}
        <rect x="{{ wifi_x + (i * 8) }}" y="{{ bar_y }}" width="6" height="{{ bar_h }}" fill="none" stroke="#333" stroke-width="1" />
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if device.get("battery_percent") is not none %}
    <text x="{{ wifi_x + 40 }}" y="{{ height - 2 }}" class="small muted">{{ device.get("battery_percent") }}%</text>
  {% endif %}
  {% endif %}

  {% if last_error %}
    <text x="20" y="{{ height - 0 }}" class="small muted">Last error: {{ last_error }}</text>
  {% endif %}
</svg>
